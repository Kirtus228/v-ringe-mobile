; Конфигурация проекта «В РИНГЕ»
config_version=5

[application]

config/name="В РИНГЕ"
config/description="Бокс-аркада: один раунд 90 секунд, вылет за канаты"
config/icon="res://icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="VRinge"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
; T6: аспект «expand» включается в main.gd::_setup_display() — здесь не дублируем,
; иначе headless-прогоны теряют канву 1280×720 (clicktest кликает мимо кнопок).
window/handheld/orientation=4

[input_devices]

; T6: тап на Android приходит как касание, а кнопки Godot ждут мышь —
; явно включаем эмуляцию мыши из касания (это и есть «кнопки не реагируют»).
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[autoload]

SaveManager="*res://scripts/save_manager.gd"
StatsManager="*res://scripts/stats_manager.gd"
NetworkManager="*res://scripts/net/network_manager.gd"

[rendering]

environment/defaults/default_clear_color=Color(0.02, 0.025, 0.04, 1)
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true
