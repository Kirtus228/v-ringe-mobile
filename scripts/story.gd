## Короткая строка для меню, чтобы сюжет не был спрятан.
const TAGLINE := "Бокс — это не «бить», а «успеть»."


static func page(i: int) -> Dictionary:
    return PAGES[clampi(i, 0, PAGES.size() - 1)]


## Открыта ли глава: пролог — сразу, глава N — когда дошёл до пояса N-1.
static func is_open(i: int, belt: int) -> bool:
    var need := int(page(i).get("need", -1))
    return need < 0 or belt >= need
